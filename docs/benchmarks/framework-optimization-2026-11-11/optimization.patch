+// Package randomid generates independent 128-bit request and invocation IDs.
+// Each generator owns its entropy buffer; there is no shared application state.
+package randomid
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"io"
+	"sync"
+)
+
+// Generator amortizes calls to crypto/rand without replacing its entropy source.
+// Its zero value is ready to use. A Generator must not be copied after use.
+type Generator struct {
+	mu        sync.Mutex
+	buffer    [256]byte
+	available int
+	// Tests can supply an instance-local source. Production always uses
+	// crypto/rand.Read, including its platform-specific failure semantics.
+	read func([]byte) (int, error)
+}
+
+// New constructs an independent generator without reading entropy or starting
+// a goroutine. Entropy is requested lazily on the first ID and each refill.
+func New() *Generator { return new(Generator) }
+
+// ID returns 32 hexadecimal characters representing fresh 128-bit entropy.
+// The string owns its bytes and remains unchanged after subsequent refills.
+func (g *Generator) ID() (string, error) {
+	var raw [16]byte
+	if err := g.take(&raw); err != nil {
+		return "", err
+	}
+	var encoded [32]byte
+	hex.Encode(encoded[:], raw[:])
+	return string(encoded[:]), nil
+}
+
+func (g *Generator) take(raw *[16]byte) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.available == 0 {
+		read := g.read
+		if read == nil {
+			read = rand.Read
+		}
+		// available remains zero until the entire refill succeeds. A short
+		// read, error, or panic can never expose a partially filled buffer.
+		n, err := read(g.buffer[:])
+		if err != nil {
+			return err
+		}
+		if n != len(g.buffer) {
+			return io.ErrUnexpectedEOF
+		}
+		g.available = len(g.buffer)
+	}
+	start := len(g.buffer) - g.available
+	copy(raw[:], g.buffer[start:start+len(raw)])
+	g.available -= len(raw)
+	return nil
+}
