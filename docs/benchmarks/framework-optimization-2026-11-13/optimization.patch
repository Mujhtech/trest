+
+func TestContextDoneExpires(t *testing.T) {
+	var ctx lazycontext.Context
+	ctx.Init(context.Background(), 5*time.Millisecond)
+	defer ctx.Cancel()
+	done := ctx.Done()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
