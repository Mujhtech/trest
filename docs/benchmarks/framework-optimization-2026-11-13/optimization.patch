+type nativeUnconstrainedInput struct {
+	Text     string `json:"text"`
+	Count    int64  `json:"count"`
+	Unsigned uint64 `json:"unsigned"`
+	Flag     bool   `json:"flag"`
+	Optional string `json:"optional,omitempty"`
