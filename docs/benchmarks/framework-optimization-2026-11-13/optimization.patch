+	}
+	largeType := reflect.StructOf(fields)
+	spec, err := Generate(largeType)
+	if err != nil {
+		t.Fatal(err)
+	}
+	validator, err := Compile(spec)
+	if err != nil {
+		t.Fatal(err)
+	}
