@@ -0,0 +1,83 @@
+package randomid
+
+import (
+	"encoding/hex"
+	"math/rand"
+	"testing"
+)
+
+func assertHexBlock(t testing.TB, raw [256]byte) {
+	t.Helper()
+	var got, want [512]byte
+	encodeHexBlock(&got, &raw)
+	hex.Encode(want[:], raw[:])
+	if got != want {
+		t.Fatalf("hex mismatch for %x: got %s; want %s", raw, got, want)
+	}
+}
+
+func TestHexBlockMatchesStandardLibrary(t *testing.T) {
+	var raw [256]byte
+	for value := range 256 {
+		for index := range raw {
+			raw[index] = byte(value)
+		}
+		assertHexBlock(t, raw)
+	}
+	for start := range 256 {
+		for index := range raw {
+			raw[index] = byte(start + index)
+		}
+		assertHexBlock(t, raw)
+	}
+	rng := rand.New(rand.NewSource(1))
+	for range 4096 {
+		if _, err := rng.Read(raw[:]); err != nil {
+			t.Fatal(err)
+		}
+		assertHexBlock(t, raw)
+	}
+}
+
+func FuzzHexBlockMatchesStandardLibrary(f *testing.F) {
+	f.Add([]byte{})
+	f.Add([]byte{0, 1, 9, 10, 15, 16, 0x7f, 0x80, 0x9f, 0xa0, 0xff})
+	seed := make([]byte, 256)
+	for index := range seed {
+		seed[index] = byte(index)
+	}
+	f.Add(seed)
+	f.Fuzz(func(t *testing.T, data []byte) {
+		if len(data) > 4096 {
+			t.Skip()
+		}
+		var raw [256]byte
+		copy(raw[:], data)
+		assertHexBlock(t, raw)
+	})
+}
+
+func BenchmarkHexBlock(b *testing.B) {
+	var raw [256]byte
+	for index := range raw {
+		raw[index] = byte(index)
+	}
+	for _, variant := range []struct {
+		name   string
+		encode func(*[512]byte, *[256]byte)
+	}{
+		{"standard", func(dst *[512]byte, src *[256]byte) { hex.Encode(dst[:], src[:]) }},
+		{"swar", encodeHexBlock},
+	} {
+		b.Run(variant.name, func(b *testing.B) {
+			var encoded [512]byte
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				variant.encode(&encoded, &raw)
+			}
+			if encoded[0] != '0' || encoded[511] != 'f' {
+				b.Fatal("unexpected encoded block")
+			}
+		})
+	}
+}
