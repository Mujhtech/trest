+package invocationctx
+
+import "context"
+
+// Principal is the immutable identity shared with operation's public type.
+type Principal struct {
+	ID       string `json:"id"`
+	TenantID string `json:"tenant_id,omitempty"`
+}
+
+// PrincipalContext owns one immutable identity wrapper. An HTTP envelope may
+// reserve its storage, but must initialize it exactly once before publication.
+// Its parent and principal never change; retained pre-authentication contexts
+// continue to resolve their own identity independently of this wrapper.
+type PrincipalContext struct {
+	context.Context
+	principal Principal
+}
+
+// Init attaches identity without probing the parent. It panics for a nil parent
+// or reused storage. The caller owns single-use initialization before sharing.
+func (c *PrincipalContext) Init(parent context.Context, principal Principal) {
+	if parent == nil {
+		panic("cannot create context from nil parent")
+	}
+	if c.Context != nil {
+		panic("cannot reuse a principal context")
+	}
+	c.Context = parent
+	c.principal = principal
+}
+
+func (c *PrincipalContext) Value(key any) any {
+	if IsPrincipalKey(key) {
+		return c
+	}
+	return c.Context.Value(key)
+}
+
+// WithPrincipal creates an independent identity wrapper without parent probes.
+func WithPrincipal(parent context.Context, principal Principal) context.Context {
+	value := new(PrincipalContext)
+	value.Init(parent, principal)
+	return value
+}
+
+// PrincipalFrom returns a copy of the current identity and whether it is set.
+func PrincipalFrom(ctx context.Context) (Principal, bool) {
+	value, _ := PrincipalValue(ctx).(*PrincipalContext)
+	if value == nil {
+		return Principal{}, false
+	}
+	return value.principal, value.principal.ID != ""
+}
