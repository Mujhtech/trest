+package invocationctx
+
+import (
+	"context"
+	"testing"
+)
+
+func TestPrincipalStorageRejectsReuseWithoutChangingRetainedIdentity(t *testing.T) {
+	var storage PrincipalContext
+	first := Principal{ID: "first", TenantID: "tenant"}
+	storage.Init(context.Background(), first)
+	func() {
+		defer func() {
+			if recover() == nil {
+				t.Fatal("principal storage was reused")
+			}
+		}()
+		storage.Init(context.Background(), Principal{ID: "second"})
+	}()
+	if principal, ok := PrincipalFrom(&storage); !ok || principal != first {
+		t.Fatal("failed reinitialization changed retained identity")
+	}
+}
