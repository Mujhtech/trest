+func TestAuthenticatedEnvelopePreservesBeforeAndAfterContexts(t *testing.T) {
+	type authenticationKey struct{}
+	for _, observed := range []bool{false, true} {
+		for _, cancelable := range []bool{false, true} {
+			t.Run(fmt.Sprintf("observed=%t/cancelable=%t", observed, cancelable), func(t *testing.T) {
+				parent := context.Background()
+				if cancelable {
+					var cancel context.CancelFunc
+					parent, cancel = context.WithCancel(parent)
+					defer cancel()
+				}
+				upstream := Principal{ID: "upstream", TenantID: "outer"}
+				parent = operation.WithPrincipal(parent, upstream)
+				var before, after, retained []context.Context
+				components := []Component{
+					Authenticate(func(r *http.Request) (Principal, error) {
+						before = append(before, r.Context())
+						id := r.Header.Get("X-Identity")
+						ctx := context.WithValue(r.Context(), authenticationKey{}, id)
+						*r = *r.WithContext(ctx)
+						after = append(after, r.Context())
+						return Principal{ID: id, TenantID: "verified"}, nil
+					}),
+					Get("/", func(ctx context.Context, _ Empty) (string, error) {
+						principal, ok := Identity(ctx)
+						if !ok || principal.ID != ctx.Value(authenticationKey{}) || principal.TenantID != "verified" {
+							t.Errorf("handler identity or post-callback parent lost: %+v", principal)
+						}
+						retained = append(retained, ctx)
+						return principal.ID, nil
+					}),
+				}
+				if observed {
+					components = append(components, Observe(operation.ObserverFunc(func(context.Context, operation.Event) {})))
+				}
+				app, err := New(components...)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, id := range []string{"first", "second"} {
+					r := httptest.NewRequest(http.MethodGet, "/", nil).WithContext(parent)
+					r.Header.Set("X-Identity", id)
+					w := httptest.NewRecorder()
+					app.ServeHTTP(w, r)
+					if w.Code != http.StatusOK || w.Body.String() != id || r.Context() != parent {
+						t.Fatalf("response=%d %q original context changed=%t", w.Code, w.Body.String(), r.Context() != parent)
+					}
+				}
+				if len(retained) != 2 || len(before) != 2 || len(after) != 2 {
+					t.Fatal("missing request contexts")
+				}
+				for index, id := range []string{"first", "second"} {
+					for _, ctx := range []context.Context{before[index], after[index]} {
+						if principal, ok := Identity(ctx); !ok || principal != upstream {
+							t.Fatal("post-authentication identity became visible through an earlier context")
+						}
+					}
+					if before[index].Value(authenticationKey{}) != nil || after[index].Value(authenticationKey{}) != id {
+						t.Fatal("authentication changed a retained parent or lost its replacement")
+					}
+					principal, ok := Identity(retained[index])
+					if !ok || principal != (Principal{ID: id, TenantID: "verified"}) || retained[index].Err() != context.Canceled {
+						t.Fatal("later request changed retained authenticated identity or lifetime")
+					}
+					principal.ID = "changed copy"
+					if got, _ := Identity(retained[index]); got.ID != id {
+						t.Fatal("principal accessor exposed mutable storage")
+					}
+				}
+			})
+		}
+	}
+}
+
+func TestAuthenticatedEnvelopeConcurrentRequestsKeepIdentity(t *testing.T) {
+	t.Parallel()
+	type captured struct {
+		context context.Context
+		id      string
+	}
+	const count = 64
+	contexts := make(chan captured, count)
+	app, err := New(
+		Authenticate(func(r *http.Request) (Principal, error) {
+			return Principal{ID: r.Header.Get("X-Identity")}, nil
+		}),
+		Get("/", func(ctx context.Context, _ Empty) (string, error) {
+			principal, _ := Identity(ctx)
+			contexts <- captured{ctx, principal.ID}
+			return principal.ID, nil
+		}),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for index := range count {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			id := fmt.Sprint(index)
+			r := httptest.NewRequest(http.MethodGet, "/", nil)
+			r.Header.Set("X-Identity", id)
+			w := httptest.NewRecorder()
+			app.ServeHTTP(w, r)
+			if w.Code != http.StatusOK || w.Body.String() != id {
+				t.Errorf("identity %s: response=%d %q", id, w.Code, w.Body.String())
+			}
+		}()
+	}
+	wg.Wait()
+	close(contexts)
+	seen := make(map[string]bool, count)
+	for captured := range contexts {
+		principal, ok := Identity(captured.context)
+		if !ok || principal.ID != captured.id || seen[principal.ID] || captured.context.Err() != context.Canceled {
+			t.Fatal("concurrent requests shared identity storage or lifetime")
+		}
+		seen[principal.ID] = true
+	}
+	if len(seen) != count {
+		t.Fatalf("retained %d identities, want %d", len(seen), count)
+	}
+}
+
+func TestRepeatedMiddlewareAuthenticationUsesIndependentIdentityWrappers(t *testing.T) {
+	var contexts []context.Context
+	count := 0
+	s := scope{
+		authenticate: func(*http.Request) (Principal, error) {
+			count++
+			return Principal{ID: fmt.Sprint(count)}, nil
+		},
+		middleware: []Middleware{func(next http.Handler) http.Handler {
+			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				next.ServeHTTP(w, r)
+				next.ServeHTTP(w, r)
+			})
+		}},
+	}
+	handler := wrapRoute(s, RouteInfo{}, contextRouteFunc(func(_ http.ResponseWriter, _ *http.Request, ctx context.Context) {
+		contexts = append(contexts, ctx)
+	}))
+	r := httptest.NewRequest(http.MethodGet, "/", nil)
+	w := httptest.NewRecorder()
+	handler.ServeHTTP(w, r)
+	if len(contexts) != 2 {
+		t.Fatalf("received %d authenticated contexts", len(contexts))
+	}
+	for index, ctx := range contexts {
+		if principal, ok := Identity(ctx); !ok || principal.ID != fmt.Sprint(index+1) {
+			t.Fatal("repeated middleware call changed retained identity")
+		}
+	}
+	if _, ok := Identity(r.Context()); ok {
+		t.Fatal("middleware authentication changed the caller's context")
+	}
+}
+
+func TestFailedAuthenticationDoesNotPublishReservedIdentity(t *testing.T) {
+	t.Parallel()
+	upstream := Principal{ID: "upstream"}
+	called, mapped := false, false
+	app, err := New(
+		Authenticate(func(*http.Request) (Principal, error) {
+			return Principal{ID: "rejected"}, operation.NewError(operation.Unauthenticated, "rejected", nil)
+		}),
+		OnError(func(ctx context.Context, err error) error {
+			mapped = true
+			if principal, ok := Identity(ctx); !ok || principal != upstream {
+				t.Error("failed authentication published its returned identity")
+			}
+			return err
+		}),
+		Get("/", func(context.Context, Empty) (string, error) {
+			called = true
+			return "unexpected", nil
+		}),
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := httptest.NewRequest(http.MethodGet, "/", nil).WithContext(operation.WithPrincipal(context.Background(), upstream))
+	w := httptest.NewRecorder()
+	app.ServeHTTP(w, r)
+	if called || !mapped || w.Code != http.StatusUnauthorized {
+		t.Fatalf("handler=%t mapped=%t status=%d", called, mapped, w.Code)
+	}
+}
