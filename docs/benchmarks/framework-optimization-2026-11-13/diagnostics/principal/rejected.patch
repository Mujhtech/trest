+package operation_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/mujhtech/trest/operation"
+)
+
+type unprobedPrincipalParent struct{}
+
+func (unprobedPrincipalParent) Deadline() (time.Time, bool) { panic("unexpected Deadline probe") }
+func (unprobedPrincipalParent) Done() <-chan struct{}       { panic("unexpected Done probe") }
+func (unprobedPrincipalParent) Err() error                  { panic("unexpected Err probe") }
+func (unprobedPrincipalParent) Value(any) any               { panic("unexpected Value probe") }
+
+func TestWithPrincipalDoesNotProbeParent(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		principal operation.Principal
+	}{
+		{"identified", operation.Principal{ID: "actor", TenantID: "tenant"}},
+		{"empty ID", operation.Principal{TenantID: "tenant"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := operation.WithPrincipal(unprobedPrincipalParent{}, test.principal)
+			got, ok := operation.PrincipalFromContext(ctx)
+			if got != test.principal || ok != (test.principal.ID != "") {
+				t.Fatalf("principal=%+v, present=%t", got, ok)
+			}
+		})
+	}
+}
+
+func TestWithPrincipalRejectsNilParent(t *testing.T) {
+	defer func() {
+		if recover() == nil {
+			t.Fatal("nil parent was accepted")
+		}
+	}()
+	var parent context.Context
+	_ = operation.WithPrincipal(parent, operation.Principal{ID: "actor"})
+}
