+package lazycontext
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+type lazyValueKey struct{}
+
+// The wrapper is noncancelable but still delegates private value lookups to a
+// canceled parent. Lazy must expose its own cause instead of that hidden cause.
+type lazyValueParent struct{ context.Context }
+
+func (lazyValueParent) Done() <-chan struct{}       { return nil }
+func (lazyValueParent) Deadline() (time.Time, bool) { return time.Time{}, false }
+func (lazyValueParent) Err() error                  { return nil }
+
+func TestLazyValueAndCauseDoNotCreateTimer(t *testing.T) {
+	parent, cancelParent := context.WithCancelCause(context.Background())
+	cancelParent(errors.New("hidden parent cause"))
+	parent = context.WithValue(parent, lazyValueKey{}, "parent value")
+	for _, test := range []struct {
+		name    string
+		timeout time.Duration
+		cancel  bool
+		wantErr error
+	}{
+		{name: "active", timeout: time.Minute},
+		{name: "canceled", timeout: time.Minute, cancel: true, wantErr: context.Canceled},
+		{name: "expired", timeout: -time.Second, wantErr: context.DeadlineExceeded},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var ctx Lazy
+			ctx.Init(lazyValueParent{Context: parent}, test.timeout)
+			defer ctx.Cancel()
+			if test.cancel {
+				ctx.Cancel()
+			}
+			if got := ctx.Value(lazyValueKey{}); got != "parent value" {
+				t.Fatalf("Value = %v, want parent value", got)
+			}
+			if got := ctx.Value(struct{}{}); got != nil {
+				t.Fatalf("unknown Value = %v, want nil", got)
+			}
+			if got := context.Cause(&ctx); got != test.wantErr {
+				t.Fatalf("Cause = %v, want %v", got, test.wantErr)
+			}
+			if ctx.timer.Load() != nil {
+				t.Fatal("Value or Cause created a timer")
+			}
+			// Once Done publishes a timer, both lookup paths must still agree.
+			_ = ctx.Done()
+			if got := ctx.Value(lazyValueKey{}); got != "parent value" {
+				t.Fatalf("materialized Value = %v", got)
+			}
+			if got := context.Cause(&ctx); got != test.wantErr {
+				t.Fatalf("materialized Cause = %v, want %v", got, test.wantErr)
+			}
+		})
+	}
+}
+
+func TestLazyValueDerivedChildCancellation(t *testing.T) {
+	for _, test := range []struct {
+		name        string
+		timeout     time.Duration
+		cancelFirst bool
+		wantErr     error
+	}{
+		{name: "child before cancel", timeout: time.Minute, wantErr: context.Canceled},
+		{name: "child after cancel", timeout: time.Minute, cancelFirst: true, wantErr: context.Canceled},
+		{name: "child after expiry", timeout: -time.Second, wantErr: context.DeadlineExceeded},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var ctx Lazy
+			ctx.Init(context.WithValue(context.Background(), lazyValueKey{}, "parent value"), test.timeout)
+			defer ctx.Cancel()
+			_ = context.Cause(&ctx)
+			if test.cancelFirst {
+				ctx.Cancel()
+			}
+			child, cancelChild := context.WithCancel(&ctx)
+			defer cancelChild()
+			ctx.Cancel()
+			select {
+			case <-child.Done():
+			default:
+				t.Fatal("child did not inherit cancellation")
+			}
+			if got := context.Cause(child); got != test.wantErr {
+				t.Fatalf("child Cause = %v, want %v", got, test.wantErr)
+			}
+			if got := child.Value(lazyValueKey{}); got != "parent value" {
+				t.Fatalf("child Value = %v", got)
+			}
+		})
+	}
+}
+
+func TestLazyValueConcurrentMaterializationAndCancellation(t *testing.T) {
+	var ctx Lazy
+	ctx.Init(context.WithValue(context.Background(), lazyValueKey{}, "parent value"), time.Minute)
+	defer ctx.Cancel()
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for worker := range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			for range 100 {
+				switch worker % 3 {
+				case 0:
+					if got := ctx.Value(lazyValueKey{}); got != "parent value" {
+						t.Errorf("Value = %v", got)
+						return
+					}
+					if cause := context.Cause(&ctx); cause != nil && cause != context.Canceled {
+						t.Errorf("Cause = %v", cause)
+						return
+					}
+				case 1:
+					child, cancelChild := context.WithCancel(&ctx)
+					cancelChild()
+					if got := context.Cause(child); got != context.Canceled {
+						t.Errorf("child Cause = %v", got)
+						return
+					}
+				case 2:
+					ctx.Cancel()
+				}
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	if got := context.Cause(&ctx); got != context.Canceled {
+		t.Fatalf("final Cause = %v", got)
+	}
+}
