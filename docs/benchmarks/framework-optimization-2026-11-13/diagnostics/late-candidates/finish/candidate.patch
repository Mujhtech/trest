+func TestPublicNativeCompletionKeepsHandlerResultAndCancelsContext(t *testing.T) {
+	for _, lifetime := range []string{"lazy", "materialized", "cancelable"} {
+		for _, fail := range []bool{false, true} {
+			outcome := "success"
+			if fail {
+				outcome = "handler error"
+			}
+			t.Run(lifetime+"/"+outcome, func(t *testing.T) {
+				parent := context.Background()
+				if lifetime == "cancelable" {
+					var cancel context.CancelFunc
+					parent, cancel = context.WithCancel(parent)
+					defer cancel()
+				}
+				handlerErr := errors.New("handler failed")
+				registry := operation.NewRegistry(nil)
+				var retained context.Context
+				handle := register(t, registry, public("native.completion.v1"), func(ctx context.Context, _ input) (output, error) {
+					retained = ctx
+					if lifetime == "materialized" {
+						_ = ctx.Done()
+					}
+					if fail {
+						return output{Name: "discard"}, handlerErr
+					}
+					return output{Name: "keep"}, nil
+				})
+				freeze(t, registry)
+				out, err := handle.Invoke(parent, input{})
+				if fail {
+					if err != handlerErr || out != (output{}) {
+						t.Fatalf("handler failure returned output=%#v error=%v", out, err)
+					}
+				} else if err != nil || out != (output{Name: "keep"}) {
+					t.Fatalf("handler success returned output=%#v error=%v", out, err)
+				}
+				if retained.Err() != context.Canceled || context.Cause(retained) != context.Canceled || parent.Err() != nil {
+					t.Fatal("completion lost cancellation or canceled the parent")
+				}
+			})
+		}
+	}
+}
