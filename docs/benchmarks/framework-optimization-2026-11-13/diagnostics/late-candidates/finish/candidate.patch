+func TestLazyFinishReturnsPriorStateAndPreservesCompletion(t *testing.T) {
+	for _, test := range []struct {
+		name        string
+		timeout     time.Duration
+		materialize bool
+		cancel      bool
+		wantError   error
+		wantCause   error
+	}{
+		{name: "active", timeout: time.Minute, wantCause: context.Canceled},
+		{name: "previously canceled", timeout: time.Minute, cancel: true, wantError: context.Canceled, wantCause: context.Canceled},
+		{name: "expired", timeout: -time.Second, wantError: context.DeadlineExceeded, wantCause: context.DeadlineExceeded},
+		{name: "materialized active", timeout: time.Minute, materialize: true, wantCause: context.Canceled},
+		{name: "materialized canceled", timeout: time.Minute, materialize: true, cancel: true, wantError: context.Canceled, wantCause: context.Canceled},
+		{name: "materialized expired", timeout: -time.Second, materialize: true, wantError: context.DeadlineExceeded, wantCause: context.DeadlineExceeded},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			var ctx lazycontext.Lazy
+			ctx.Init(context.WithValue(context.Background(), valueKey{}, "retained"), test.timeout)
+			defer ctx.Cancel()
+			if test.materialize {
+				_ = ctx.Done()
+			}
+			if test.cancel {
+				ctx.Cancel()
+			}
+			if got := ctx.Finish(); got != test.wantError {
+				t.Fatalf("Finish = %v, want %v", got, test.wantError)
+			}
+			ctx.Cancel()
+			if got := ctx.Finish(); got != test.wantCause {
+				t.Fatalf("repeated Finish = %v, want %v", got, test.wantCause)
+			}
+			if ctx.Err() != test.wantCause || context.Cause(&ctx) != test.wantCause {
+				t.Fatalf("retained error/cause = %v/%v, want %v", ctx.Err(), context.Cause(&ctx), test.wantCause)
+			}
+			assertClosed(t, ctx.Done())
+			if ctx.Value(valueKey{}) != "retained" {
+				t.Fatal("Finish discarded parent values")
+			}
+		})
+	}
+}
