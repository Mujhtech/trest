+func TestPublicNativeCancellationPrecedesHandlerError(t *testing.T) {
+	parent, cancelParent := context.WithCancelCause(context.Background())
+	defer cancelParent(nil)
+	cause := errors.New("parent stopped")
+	registry := operation.NewRegistry(nil)
+	var retained context.Context
+	handle := register(t, registry, public("native.error.precedence.v1"), func(ctx context.Context, _ input) (output, error) {
+		retained = ctx
+		cancelParent(cause)
+		return output{Name: "discard"}, errors.New("handler failed")
+	})
+	freeze(t, registry)
+	out, err := handle.Invoke(parent, input{})
+	if out != (output{}) || operation.CodeOf(err) != operation.Canceled || !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation did not precede handler failure: output=%#v error=%v", out, err)
+	}
+	if context.Cause(retained) != cause {
+		t.Fatalf("completion changed the parent's cause: %v", context.Cause(retained))
+	}
