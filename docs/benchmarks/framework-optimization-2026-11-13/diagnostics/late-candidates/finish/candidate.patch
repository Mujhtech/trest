+// Finish checks the invocation's final error and releases its resources in one
+// step. An active, unobserved invocation reads its deadline once and records
+// cancellation before returning success. Retained contexts remain canceled.
+// Callers must still defer Cancel so panic and early-return paths release it.
+func (c *Lazy) Finish() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if timer := c.timer.Load(); timer != nil {
+		// Preserve the standard-library Err-before-cancel boundary once the
+		// lifetime has been exposed through Done or Value.
+		err := timer.Err()
+		timer.cancel()
+		return err
