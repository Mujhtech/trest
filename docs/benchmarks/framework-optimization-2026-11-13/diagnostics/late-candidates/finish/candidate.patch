+func TestContextFinishPreservesParentCause(t *testing.T) {
+	parent, cancelParent := context.WithCancelCause(context.Background())
+	defer cancelParent(nil)
+	var ctx lazycontext.Context
+	ctx.Init(parent, time.Minute)
+	defer ctx.Cancel()
+	child, cancelChild := context.WithCancel(&ctx)
+	defer cancelChild()
+	cause := errors.New("parent stopped before completion")
+	cancelParent(cause)
+	if err := ctx.Finish(); err != context.Canceled {
+		t.Fatalf("Finish = %v, want canceled", err)
