+package randomid
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+)
+
+func TestReservoirBatchesReadsWithoutGrowingRetainedBlocks(t *testing.T) {
+	t.Parallel()
+	calls := 0
+	source := countingSource()
+	g := &Generator{read: func(dst []byte) (int, error) {
+		calls++
+		if len(dst) != 1024 {
+			t.Errorf("entropy read length=%d, want 1024", len(dst))
+		}
+		return source(dst)
+	}}
+	var retained []string
+	var previous *encodedBlock
+	blocks := 0
+	for sequence := 1; sequence <= 128; sequence++ {
+		id, err := g.ID()
+		if err != nil {
+			t.Fatal(err)
+		}
+		retained = append(retained, id)
+		if got := idSequence(t, id); got != uint64(sequence) {
+			t.Fatalf("ID %d consumed entropy segment %d", sequence, got)
+		}
+		if want := (sequence + 63) / 64; calls != want {
+			t.Fatalf("ID %d caused %d raw reads, want %d", sequence, calls, want)
+		}
+		block := g.current.Load()
+		if len(block.encoded) != 512 {
+			t.Fatalf("encoded block grew to %d bytes", len(block.encoded))
+		}
+		if block != previous {
+			blocks++
+			previous = block
+		}
+	}
+	if blocks != 8 {
+		t.Fatalf("128 IDs used %d encoded blocks, want 8", blocks)
+	}
+	// All raw bytes have been consumed. Rewriting that private scratch storage
+	// must not affect any returned ID or its separately owned encoded block.
+	clear(g.buffer[:])
+	for index, id := range retained {
+		if got := idSequence(t, id); got != uint64(index+1) {
+			t.Fatalf("retained ID %d changed after raw storage was cleared: %d", index, got)
+		}
+	}
+}
+
+func TestPairUsesUnreadReservoirAcrossEncodedBlockBoundaries(t *testing.T) {
+	t.Parallel()
+	for _, warm := range []int{15, 31, 47} {
+		t.Run(fmt.Sprintf("after_%d_IDs", warm), func(t *testing.T) {
+			calls := 0
+			source := countingSource()
+			g := &Generator{read: func(dst []byte) (int, error) {
+				calls++
+				if calls > 1 {
+					return 0, errors.New("raw entropy was requested before the reservoir was exhausted")
+				}
+				return source(dst)
+			}}
+			for range warm {
+				if _, err := g.ID(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			first, second, err := g.Pair()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if idSequence(t, first) != uint64(warm+1) || idSequence(t, second) != uint64(warm+2) || calls != 1 {
+				t.Fatalf("pair lost consecutive prefetched entropy: %q %q, reads=%d", first, second, calls)
+			}
+		})
+	}
+}
